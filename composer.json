{
    "name": "cemililik/nicepay-payment-gateway",
    "description": "NicePay Payment Gateway integration for WordPress and WooCommerce",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "cemililik",
            "homepage": "https://github.com/cemililik"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload-dev": {
        "psr-4": {
            "NicePay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test-coverage": "phpunit --configuration phpunit.xml --coverage-html tests/coverage",
        "test-filter": "phpunit --configuration phpunit.xml --filter"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
