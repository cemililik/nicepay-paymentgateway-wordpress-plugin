{
    "name": "cemililik/nicepay-payment-gateway",
    "description": "NicePay Payment Gateway integration for WordPress and WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "cemililik",
            "homepage": "https://github.com/cemililik"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "NicePay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test-coverage": "phpunit --configuration phpunit.xml --coverage-html tests/coverage --coverage-clover tests/coverage/clover.xml && node .github/scripts/check-coverage.js tests/coverage/clover.xml 51",
        "test-filter": "phpunit --configuration phpunit.xml --filter",
        "lint:php": "bash .github/scripts/lint-php.sh",
        "lint:js": "node .github/scripts/check-js.js",
        "check-version": "node .github/scripts/check-version.js",
        "quality": [
            "@lint:php",
            "@lint:js",
            "@check-version"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "platform": {
            "php": "7.4.33"
        }
    }
}
